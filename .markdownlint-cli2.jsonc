{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD036": false,
    "MD040": false,
    "MD060": false,
    "MD032": false,
    "MD022": false,
    "MD034": false,
    "MD012": false,
    "MD029": false,
    "MD056": false,
  },
  "globs": [
    "AGENTS.md",
    "docs/guide.md",
    "docs/standards.md",
    "docs/framework.md",
    "docs/patterns.md",
    "docs/ai/**/*.md",
    "examples/**/*.md",
    "packages/*/README.md",
    "addons/*/README.md",
    "packages/blora-design/docs/**/*.md",
    "addons/*/contracts/**/*.md",
  ],
  "ignores": [
    "legacy/**",
    "node_modules/**",
    "dist/**",
    ".trashes/**",
    ".agents/**",
    "playwright-report/**",
    "test-results/**",
  ],
}
