{
  "name": "blora-design-monorepo",
  "private": true,
  "type": "module",
  "description": "Blora Design 3.0 monorepo",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:design && pnpm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"packages/*/src/**/*.css\"",
    "lint:design": "node scripts/lint-design.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@bloret-crew/cortado": "^0.1.0",
    "@bloret-crew/stylelint-config-blora": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.4.0",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
