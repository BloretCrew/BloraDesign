{
  "name": "@bloret-crew/blora-design-layout",
  "version": "2.1.0",
  "description": "Layout helpers add-on for Blora Design 2.0 (sidebar, affix, anchor, scroll-spy, smooth-scroll).",
  "license": "Apache-2.0",
  "type": "module",
  "author": "RhedarLiu <rhedarliu@outlook.com>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout.global.js": "./dist/layout.global.js",
    "./layout.css": "./dist/layout.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "contracts/"
  ],
  "scripts": {
    "lint": "eslint src/ tests/ --no-error-on-unmatched-pattern",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "vite build && tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "@bloret-crew/blora-design": "workspace:*"
  }
}
